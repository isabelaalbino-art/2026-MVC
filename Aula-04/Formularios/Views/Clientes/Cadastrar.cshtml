@model MVC2026.Cliente
@{
    ViewData["Title"] = "Cadastro de Clientes";
}

<div class="container">

    <h1 class="text-center mt-3 fw-bold">Cadastro de Cliente</h1>
    
    <form action="#" method="get">
        <div class="row gap-5  justify-content-center">
           <div class=" col-12 col-md-4 col-lg-3 mt-4">
                <label asp-for="Id">Código</label>
                <input type="number" class="form-control rounded-4 h-500" placeholder="Código do Cliente..." asp-for="Id">
            </div>
             <div class=" col-12 col-md-4 col-lg-3 mt-4">
                <label asp-for="Nome">Nome Completo</label>
                <input type="text" class="form-control rounded-4 h-500"  placeholder="Nome Completo..." " asp-for="Nome">
            </div>
             <div class=" col-12 col-md-4 col-lg-3 mt-4">
                <label asp-for="Endereco">Endereço</label>
                <input type="text" class="form-control rounded-4 h-500"  placeholder="Endereço..." " asp-for="Endereco">
            </div>
             <div class=" col-12 col-md-4 col-lg-3 mt-4">
                <label asp-for="Bairro">Seu bairro</label>
                <input type="text" class="form-control rounded-4 h-500" placeholder="Bairro..." " asp-for="Bairro">
            </div>
             <div class=" col-12 col-md-4 col-lg-3 mt-4">
                <label asp-for="Cidade">Cidade</label>
                <input type="text" class="form-control rounded-4 h-500"  placeholder="Cidade..." " asp-for="Cidade">
            </div>
             <div class=" col-12 col-md-4 col-lg-3 mt-4">
                <label asp-for="UF">UF</label>
                <input type="text" class="form-control rounded-4 h-500"  placeholder="UF..."  asp-for="UF">
            </div>
             <div class=" col-12 col-md-4 col-lg-3 mt-4">
                <label asp-for="CEP">CEP</label>
                <input type="text" class="form-control rounded-4 h-500"  placeholder="CEP..."  asp-for="CEP">
            </div>
             <div class=" col-12 col-md-4 col-lg-3 mt-4">
                <label asp-for="CPF">CPF</label>
                <input type="text" class="form-control rounded-4 h-500"  placeholder="CPF..."  asp-for="CPF">
            </div>
             <div class=" col-12 col-md-4 col-lg-3 mt-4">
                <label asp-for="Email">Email</label>
                <input type="text" class="form-control rounded-4 h-500"  placeholder="Email..."  asp-for="Email">
            </div>
             <div class=" col-12 col-md-4 col-lg-3 mt-4">
                <label asp-for="Celular">Celular</label>
                <input type="text" class="form-control rounded-4 h-500"  placeholder="Celular..."  asp-for="Celular">
            </div>
             <div class=" col-12 col-md-4 col-lg-3 mt-4">
                <label asp-for="DataNascimento">DataNascimento</label>
                <input type="text" class="form-control rounded-4 h-500"  placeholder="00/00/0000"  asp-for="DataNascimento">
            </div>
             <div class=" col-12 col-md-4 col-lg-3 mt-4">
                <label asp-for="Observacao">Observação</label>
                <input type="text" class="form-control rounded-4 h-500"  placeholder="Observação..."  asp-for="Observacao">
            </div>
        
            
        </div>


                <div class="row mt-5">
            <div class="col text-center">
                <input type="reset" value="Limpar" class="w-50 btn btn-outline-secondary"/>
            </div>
            <div class="col text-center">
                <input type="submit" value="Enviar" class="w-50 btn btn-primary" />
            </div>
       

        </div>
    </form>

</div>