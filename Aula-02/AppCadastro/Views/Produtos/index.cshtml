@model IEnumerable<MVC2026.Produto>
  @{
    ViewData["Title"] = "Home Page";
}



<h1 class = "text-center text-primary display-3">Cadastro de Produtos</h1>

<table class = "bg-black table-dark table table-bordered text-hover">
    <thead>
        <tr>
           
            <td class = "fw-bold fs-3">Nome</td>
            <td class = "fw-bold fs-6">Quantidade</td>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model){
            <tr>
              
                <td>@item.Nome</td>
                <td>@item.Quantidade</td>
            </tr>
        }
    </tbody>
</table> 